# backend/.env.example
# Optional: Provide a GitHub Personal Access Token to increase rate limits from 60 requests/hour to 5,000 requests/hour.
# The application works without a token for public repositories within rate limits.
GITHUB_TOKEN=
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
